# Contraseña del panel /admin (por defecto en local: ayv-admin-local)
ADMIN_PASSWORD=ayv-admin-local

# Vercel Blob (recomendado en producción):
# - Persiste products.json / announcements.json / categories.json
# - Sube imágenes del admin (productos y novedades) a Blob y guarda la URL pública
# Sin token: en local el CRUD usa data/*.json y las imágenes van a public/uploads/
# En Vercel sin token: el catálogo no persiste entre deploys y la subida de imágenes falla con mensaje claro
# BLOB_READ_WRITE_TOKEN=
